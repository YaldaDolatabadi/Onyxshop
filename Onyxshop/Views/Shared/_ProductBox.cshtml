@model IEnumerable<product>


   <div class=row>

        @foreach (var i in Model)
    {
        
        <div class="d-flex col-12 col-lg-4" >
            <div class="card" >
  <img class="card-img-top" src="/images/@(i.Id).jpg" alt="Card image cap" >
  <div class="card-body">
    <h5 class="card-title">@i.Name</h5>
    <p class="card-text">@i.description.</p>
    @*ارسال به اکشن با پارامتر*@
    <a asp-action="details" asp-controller="home" asp-route-id="@i.Id" class="btn btn-warning">جزئیات</a>
  </div>
</div>
        </div>   
    }
   </div>

