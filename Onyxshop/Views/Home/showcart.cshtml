@model Order;
@{
    ViewData["Title"] = "سبد خرید";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h1>سبد خرید شما</h1>
@*@if (@Model!=null)
{    <div class="alert">  سبد خریدت خالیه</div>

}
else
{*@
    <div dir='rtl'>
        <table class="table table-hover">
