@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model Onyxshop.Pages.Admin.IndexModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<h1>لیست کالاها</h1>
<hr />

    @* <a asp-page="AddProduct"> افزودن محصول </a>
        asp-route-roleId="YourRoleID" asp-route-userId="YourUserID"
    *@

   
    @*<a asp-page="/Admin/AddProduct" asp-route-roleId="1" asp-route-userId="1"> اضافه کردن محصول</a>*@
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#addproduct">
        <img src=~/images/icon/48761_file_add_upload_icon.png/>
        افزودن محصول
    </button>
    <hr/>
  
    <!-- Modal -->

               @*     @{await Html.RenderPartialAsync("AddProduct");}*@
<div class="modal fade" id="addproduct" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-md" role="document">
    <div class="modal-content">
      <div class="modal-header shadow-sm p-3 mb-5 bg-info text-white">
        <h5 class="modal-title" id="exampleModalLabel" style="text-shadow: -1px 0 black, 0 1px black, 1px 0 black, 0 -1px black;">افزودن کالای جدید</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
             <div class="rtl md-from">
                        <form method="post" enctype="multipart/form-data"  class="col-10 rtl"id="AddNewProduct">
                        <dl >
                          <dd>  <label asp-for="newproduct.name">نام محصول</label></dd>
                            <dt>
                                <input asp-for="newproduct.name"  />
                                <span asp-validation-for="newproduct.name" class="text-danger"></span>
                            </dt>
                            <dd><label asp-for="newproduct.description">توضیحات</label></dd>
                            <dt>
                                <textarea asp-for="newproduct.description" class="form-control"></textarea>
                                <span asp-validation-for="newproduct.description" class="text-danger"></span>
                            </dt>
                                 <dd><label asp-for="newproduct.vazn">وزن</label></dd>
                            <dt>
                                <input asp-for="newproduct.vazn" class="form-control" />
                                <span asp-validation-for="newproduct.vazn" class="text-danger"></span>
                            </dt>
                            <dd><label asp-for="newproduct.price">قیمت</label></dd>
                            <dt>
                                <input asp-for="newproduct.price" class="form-control" />
                                <span asp-validation-for="newproduct.price"class="text-danger"></span>
                            </dt>
                            <dd><label asp-for="newproduct.quantityinstock">تعداد در واحد</label></dd>
                            <dt>
                                <input asp-for="newproduct.quantityinstock" class="form-control" />
                                <span asp-validation-for="newproduct.quantityinstock"class="text-danger"></span>
                            </dt>
                            <dd><label asp-for="newproduct.picture">تصویر</label></dd>
                            <dt>
                                <input asp-for="newproduct.picture" />
                                <span asp-validation-for="newproduct.picture"class="text-danger"></span>
                            </dt>
                            <dd></dd>
                            <dt>
                                <br />
                                <input type="submit" class="btn btn-success" value="ثبت"  />
                              @*  onclick="SubmitForms('AddNewProduct'); return false;"*@
                            </dt>
                        </dl>
                                            </form>
    </div>


 

    @*فرم*@
                 </div>
      <div class="modal-footer">
        @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>*@
        @*<button type="button" class="btn btn-primary">ثبت </button>*@
      </div>
    </div>
  </div>
</div>






<table  class="table table-hover  table-striped" >
       <thead class="table-primary">

        <tr>
            <th>تصویر</th>
            <th>نام</th>
            <th>قیمت</th>
            <th>دستورات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.products)
        {
            <tr>
                <td> <img src="/images/@(item.Id).jpg" alt="Card image cap" style="width:100px; border:1px solid gray; padding:4px"> </td>

                <td>@item.Name</td>
                <td>@item.SabadItem.price</td>
                <td>
                    <a asp-page="Edit" asp-route-id="@item.Id">ویرایش</a>
                    <p>  /  </p>
         @*           <a asp-page="Index" asp-page-handler="OnGetdelete" asp-route-id="@item.Id">حذف</a>*@
               <a asp-page="delete"  asp-route-id="@item.Id">حذف</a>
                </td>
            </tr>
@*            <div class="modal fade" id="deleteproduct" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <p>  آیا از حذف این کالا از لیست محصولات مطمئن هستید؟ </p>
    <button asp-page="Index" asp-page-handler="OnGetdelete" asp-route-id="@item.Id">آری</button>
    <button>نه </button>
</div>*@

        }
    </tbody>
</table>



